---
import '../styles/design.css';
import '../styles/app.css';
import { SITE, t, url } from '../lib/i18n';
import Topbar from '../components/Topbar.astro';
import StatusBar from '../components/StatusBar.astro';
import Palette from '../components/Palette.astro';

interface Props {
  title?: string;
  description?: string;
  /** Section path shown in the status bar, e.g. "work". */
  path?: string;
  /** Which nav item to mark current (used by sub-pages). */
  active?: string;
}

const {
  title = 'Julio López — Senior full-stack software engineer',
  description = 'Senior full-stack software engineer. Legacy modernization, operations platforms and e-commerce.',
  path = '~/julio',
  active = '',
} = Astro.props;

/* Client-side UI copy (status messages, theme names, palette labels).
   Content strings stay server-rendered — this is only what JS needs. */
const ui = {
  site: { email: SITE.email, links: SITE.links, base: import.meta.env.BASE_URL },
  en: { status: t('en', 'status'), theme: t('en', 'theme'), palette: t('en', 'palette') },
  es: { status: t('es', 'status'), theme: t('es', 'theme'), palette: t('es', 'palette') },
};
---

<!doctype html>
<html lang="en" data-lang="en" data-active={active}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <script is:inline>
      /* Theme and language boot — runs before first paint so nothing flashes.
         Keys: pf.theme (light | dark | system), pf.lang (en | es). */
      (() => {
        const root = document.documentElement;
        const read = (key) => {
          try {
            return localStorage.getItem(key);
          } catch {
            return null;
          }
        };

        const theme = read('pf.theme');
        if (theme === 'light' || theme === 'dark') root.dataset.theme = theme;
        root.dataset.themePref = theme === 'light' || theme === 'dark' ? theme : 'system';

        const stored = read('pf.lang');
        const lang =
          stored === 'en' || stored === 'es'
            ? stored
            : /^es\b/i.test(navigator.language || '')
              ? 'es'
              : 'en';
        root.dataset.lang = lang;
        root.lang = lang;
      })();
    </script>
  </head>
  <body>
    <script type="application/json" id="site-config" set:html={JSON.stringify(ui)}></script>
    <a class="skip" href="#top">Skip to content</a>
    <Topbar active={active} />
    <slot />
    <StatusBar path={path} />
    <Palette />
    <script>
      import '../scripts/client';
    </script>
  </body>
</html>
