---
import Bi from './Bi.astro';
import { url } from '../lib/i18n';
import { s, SITE } from '../lib/i18n';

const L = 'en' as const;
const { active = '' } = Astro.props;

const links = [
  { id: 'work', href: url('/#work'), key: 'nav.work' },
  { id: 'devlog', href: url('/#devlog'), key: 'nav.devlog' },
  { id: 'experience', href: url('/#experience'), key: 'nav.experience' },
  { id: 'stack', href: url('/#stack'), key: 'nav.stack' },
  { id: 'about', href: url('/#about'), key: 'nav.about' },
  { id: 'contact', href: url('/#contact'), key: 'nav.contact' },
  { id: 'design-system', href: url('/design-system/'), key: 'nav.system' },
];
---

<header class="topbar">
  <div class="wrap topbar__row">
    <a class="brand" href={url('/#top')} aria-label={s(L, 'a11y.home')} data-i18n-attr="aria-label:a11y.home">
      <span class="brand__glyph">~/</span>{SITE.brand}<span class="brand__crumb" id="crumb" aria-hidden="true"></span>
    </a>

    <nav class="nav" id="nav" aria-label={s(L, 'a11y.sections')} data-i18n-attr="aria-label:a11y.sections">
      {links.map((link) => (
        <a class="nav__link" href={link.href} data-nav={link.id} data-i18n={link.key} aria-current={link.id === active ? 'true' : undefined}><Bi en={s(L, link.key)} es={s('es', link.key)} /></a>
      ))}
      <span class="nav__ind" id="nav-ind" aria-hidden="true"></span>
    </nav>

    <div class="topbar__tools">
      <div class="seg" role="radiogroup" data-seg="lang" aria-label={s(L, 'a11y.language')} data-i18n-attr="aria-label:a11y.language">
        <button class="seg__opt" type="button" role="radio" data-value="en" aria-checked="true" aria-label="English">EN</button>
        <button class="seg__opt" type="button" role="radio" data-value="es" aria-checked="false" aria-label="Español">ES</button>
      </div>

      <div class="seg" role="radiogroup" data-seg="theme" aria-label={s(L, 'a11y.theme')} data-i18n-attr="aria-label:a11y.theme">
        <button class="seg__opt" type="button" role="radio" data-value="system" aria-checked="true"
          aria-label={s(L, 'theme.system')} data-tip={s(L, 'theme.system')}>
          <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="5.5" fill="none" stroke="currentColor" stroke-width="1.4"></circle><path d="M8 2.5a5.5 5.5 0 0 1 0 11z" fill="currentColor"></path></svg>
        </button>
        <button class="seg__opt" type="button" role="radio" data-value="light" aria-checked="false"
          aria-label={s(L, 'theme.light')} data-tip={s(L, 'theme.light')}>
          <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="2.8" fill="currentColor"></circle><path d="M8 1v2M8 13v2M1 8h2M13 8h2M3.05 3.05l1.4 1.4M11.55 11.55l1.4 1.4M3.05 12.95l1.4-1.4M11.55 4.45l1.4-1.4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="square"></path></svg>
        </button>
        <button class="seg__opt" type="button" role="radio" data-value="dark" aria-checked="false"
          aria-label={s(L, 'theme.dark')} data-tip={s(L, 'theme.dark')}>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M13.2 9.6A5.6 5.6 0 1 1 6.4 2.8a4.6 4.6 0 0 0 6.8 6.8z" fill="currentColor"></path></svg>
        </button>
      </div>

      <button class="btn kbd-btn" type="button" data-palette-open aria-haspopup="dialog"
        aria-label={s(L, 'palette.open')} data-tip={s(L, 'palette.open')}>
        <span class="kbd">Ctrl K</span>
      </button>
    </div>
  </div>
</header>
