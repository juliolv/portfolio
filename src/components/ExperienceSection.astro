---
import Bi from './Bi.astro';
import { s } from '../lib/i18n';
import experience from '../data/experience.json';

const L = 'en' as const;
---

<section class="section" id="experience" aria-labelledby="exp-h">
  <div class="section__head">
    <p class="eyebrow">~/julio/<b>experience</b></p>
    <h2 class="section__title" id="exp-h"><Bi en={s(L, 'experience.title')} es={s('es', 'experience.title')} /></h2>
    <p class="section__note"><Bi en={s(L, 'experience.note')} es={s('es', 'experience.note')} /></p>
  </div>

  <div class="section__body">
    <ol class="tl">
      {experience.map((row) => (
        <li class="tl__item">
          <span class="tl__when"><Bi en={row.when} es={row.whenEs} /></span>
          <div>
            <h3 class="tl__role"><Bi en={row.role} es={row.roleEs} /></h3>
            <p class="tl__org"><Bi en={row.org} es={row.orgEs} /></p>
            <p class="tl__text"><Bi en={row.text} es={row.textEs} /></p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
