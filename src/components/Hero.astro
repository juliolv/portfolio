---
import Bi from './Bi.astro';
import { t, s, SITE } from '../lib/i18n';

const L = 'en' as const;
const card = t(L, 'hero.card') as [string, string][];
const cardEs = t('es', 'hero.card') as [string, string][];
---

<section class="hero" id="top" aria-labelledby="hero-name">
  <div class="hero__main">
    <p class="prompt"><span class="prompt__glyph">›</span><span class="prompt__cmd">whoami</span></p>

    <h1 class="hero__name" id="hero-name">{SITE.name}</h1>

    <p class="hero__role">
      <span class="prompt__glyph" aria-hidden="true">› </span><Bi en={s(L, 'hero.role')} es={s('es', 'hero.role')} />
    </p>

    <p class="hero__pitch"><Bi en={s(L, 'hero.pitch')} es={s('es', 'hero.pitch')} /></p>

    <div class="hero__actions">
      <a class="btn btn--primary" href={SITE.links.cv} target="_blank" rel="noopener">
        <span class="btn__glyph" aria-hidden="true">↓</span><Bi en={s(L, 'hero.cv')} es={s('es', 'hero.cv')} />
      </a>
      <button class="btn" type="button" data-copy-email>
        <span class="btn__glyph" aria-hidden="true">@</span><Bi en={s(L, 'hero.email')} es={s('es', 'hero.email')} />
      </button>
      <a class="btn" href={SITE.links.github} target="_blank" rel="noopener">GitHub <span class="btn__glyph" aria-hidden="true">↗</span></a>
      <a class="btn" href={SITE.links.linkedin} target="_blank" rel="noopener">LinkedIn <span class="btn__glyph" aria-hidden="true">↗</span></a>
    </div>

    <p class="hero__status">
      <span class="status status--done"><span aria-hidden="true">●</span> <Bi en={s(L, 'hero.available')} es={s('es', 'hero.available')} /></span>
      <Bi en={s(L, 'hero.availableNote')} es={s('es', 'hero.availableNote')} />
    </p>
  </div>

  <aside class="pane hero__side" aria-label={s(L, 'hero.cardLabel')}>
    <div class="pane__bar">
      <span class="pane__title">~/julio/<b>summary</b></span>
      <span>{s(L, 'hero.cardMeta')}</span>
    </div>
    <div class="pane__body">
      <dl class="kv">
        {card.map(([key, value], i) => (
          <>
            <dt>{key}</dt>
            <dd><Bi en={key === 'contact' ? SITE.email : value} es={key === 'contact' ? SITE.email : (cardEs[i] ?? [])[1]} /></dd>
          </>
        ))}
      </dl>
    </div>
  </aside>
</section>
