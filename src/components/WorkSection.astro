---
import { getCollection } from 'astro:content';
import Bi from './Bi.astro';
import { s, url } from '../lib/i18n';

const L = 'en' as const;

const STATUS_CLASS: Record<string, string> = {
  done: 'status--done',
  progress: 'status--progress',
  planned: 'status--planned',
};

const items = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<section class="section" id="work" aria-labelledby="work-h">
  <div class="section__head">
    <p class="eyebrow">~/julio/<b>work</b></p>
    <h2 class="section__title" id="work-h"><Bi en={s(L, 'work.title')} es={s('es', 'work.title')} /></h2>
    <p class="section__note"><Bi en={s(L, 'work.note')} es={s('es', 'work.note')} /></p>
  </div>

  <div class="section__body">
    <p class="prompt">
      <span class="prompt__glyph">›</span><span class="prompt__cmd">ls -l work/</span>
      <span>{items.length} items</span>
    </p>

    <div class="cards">
      {items.map(({ id, data }) => (
        <article class="pane card">
          <div class="pane__bar">
            <span class="pane__title">work/<b>{id}</b>.md</span>
            <span><Bi en={data.period} es={data.periodEs} /></span>
          </div>

          <div class="card__body">
            <h3 class="card__name">
              <a class="card__link" href={url(`/work/${id}/`)}>
                <Bi en={data.name} es={data.nameEs} />
              </a>
            </h3>
            <dl class="kv">
              <dt><Bi en={s('en', 'work.labels.problem')} es={s('es', 'work.labels.problem')} /></dt>
              <dd><Bi en={data.problem} es={data.problemEs} /></dd>
              <dt><Bi en={s('en', 'work.labels.role')} es={s('es', 'work.labels.role')} /></dt>
              <dd><Bi en={data.role} es={data.roleEs} /></dd>
              <dt><Bi en={s('en', 'work.labels.stack')} es={s('es', 'work.labels.stack')} /></dt>
              <dd>
                <span class="tags">
                  {data.stack.map((tech) => <span class="tag">{tech}</span>)}
                </span>
              </dd>
              <dt><Bi en={s('en', 'work.labels.outcome')} es={s('es', 'work.labels.outcome')} /></dt>
              <dd><Bi en={data.outcome} es={data.outcomeEs} /></dd>
            </dl>
          </div>

          <div class="card__foot">
            <span class={`status ${STATUS_CLASS[data.status] ?? 'status--planned'}`}>
              <span aria-hidden="true">●</span>
              <Bi en={s('en', `status.${data.status}`)} es={s('es', `status.${data.status}`)} />
            </span>
            <a class="link link--mono card__more" href={url(`/work/${id}/`)}>
              <Bi en={s(L, 'case.read')} es={s('es', 'case.read')} />{' '}
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
