---
import { getCollection } from 'astro:content';
import Bi from './Bi.astro';
import { s } from '../lib/i18n';

const L = 'en' as const;
const items = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<section class="section" id="work" aria-labelledby="work-h">
  <div class="section__head">
    <p class="eyebrow">~/julio/<b>work</b></p>
    <h2 class="section__title" id="work-h"><Bi en={s(L, 'work.title')} es={s('es', 'work.title')} /></h2>
    <p class="section__note"><Bi en={s(L, 'work.note')} es={s('es', 'work.note')} /></p>
  </div>

  <div class="section__body">
    <p class="prompt">
      <span class="prompt__glyph">›</span><span class="prompt__cmd">ls -l work/</span>
      <span>{items.length} items</span>
    </p>

    <div class="cards">
      {items.map(({ id, data }) => (
        <article class="pane card">
          <div class="pane__bar">
            <span class="pane__title">work/<b>{id}</b>.md</span>
            <span>{data.period}</span>
          </div>

          <div class="card__body">
            <h3 class="card__name"><Bi en={data.name} es={data.nameEs} /></h3>
            <dl class="kv">
              <dt>{s(L, 'work.labels.problem')}</dt>
              <dd><Bi en={data.problem} es={data.problemEs} /></dd>
              <dt>{s(L, 'work.labels.role')}</dt>
              <dd><Bi en={data.role} es={data.roleEs} /></dd>
              <dt>{s(L, 'work.labels.stack')}</dt>
              <dd>
                <span class="tags">
                  {data.stack.map((tech) => <span class="tag">{tech}</span>)}
                </span>
              </dd>
              <dt>{s(L, 'work.labels.outcome')}</dt>
              <dd><Bi en={data.outcome} es={data.outcomeEs} /></dd>
            </dl>
          </div>

          {data.status !== 'done' && (
            <div class="card__foot">
              <span class="tag tag--dashed">
                <Bi en={s(L, 'work.soon')} es={s('es', 'work.soon')} />
              </span>
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
