---
import { s } from '../lib/i18n';
const L = 'en' as const;
---

<div class="palette" id="palette" hidden>
  <div class="palette__backdrop" data-palette-close></div>
  <div class="palette__panel pane" role="dialog" aria-modal="true" aria-labelledby="palette-title">
    <h2 class="sr-only" id="palette-title">{s(L, 'palette.title')}</h2>
    <div class="palette__field">
      <span class="prompt__glyph" aria-hidden="true">›</span>
      <input
        class="palette__input"
        id="palette-input"
        type="text"
        role="combobox"
        aria-expanded="false"
        aria-controls="palette-list"
        aria-autocomplete="list"
        autocomplete="off"
        spellcheck="false"
        placeholder={s(L, 'palette.placeholder')}
        aria-label={s(L, 'palette.title')}
        data-i18n-attr="placeholder:palette.placeholder;aria-label:palette.title"
      />
    </div>
    <ul class="palette__list" id="palette-list" role="listbox" aria-label={s(L, 'palette.title')}></ul>
    <div class="palette__hint" aria-hidden="true">
      <span>↑↓ <span>{s(L, 'palette.hNav')}</span></span>
      <span>↵ <span>{s(L, 'palette.hRun')}</span></span>
      <span>esc <span>{s(L, 'palette.hClose')}</span></span>
    </div>
  </div>
</div>
