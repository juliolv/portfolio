---
import Bi from './Bi.astro';
import { t, s } from '../lib/i18n';
import stack from '../data/stack.json';

const L = 'en' as const;
const groupsEn = t(L, 'stack.groups') as string[];
const groupsEs = t('es', 'stack.groups') as string[];
---

<section class="section" id="stack" aria-labelledby="stack-h">
  <div class="section__head">
    <p class="eyebrow">~/julio/<b>stack</b></p>
    <h2 class="section__title" id="stack-h"><Bi en={s(L, 'stack.title')} es={s('es', 'stack.title')} /></h2>
    <p class="section__note"><Bi en={s(L, 'stack.note')} es={s('es', 'stack.note')} /></p>
  </div>

  <div class="section__body">
    <div class="stack">
      {stack.map((group, i) => (
        <section class="pane">
          <div class="pane__bar">
            <span class="pane__title"><b>stack</b>/<Bi en={groupsEn[i]} es={groupsEs[i]} /></span>
            <span>{group.items.length}</span>
          </div>
          <div class="pane__body">
            <ul class="stack__list">
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </section>
      ))}
    </div>
  </div>
</section>
