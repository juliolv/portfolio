---
/**
 * Icon tile, rasterised at 32 and 180 by the capture step. One source for both
 * sizes keeps the mark identical to the favicon and the title bar.
 */
import '../styles/tokens.css';
---

<!doctype html>
<html lang="en" data-skin="wave">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>icon</title>
    <style>
      html, body { margin: 0; width: 180px; height: 180px; background: #0d1017; }
      body { display: grid; place-items: center; }
      svg { width: 76%; height: 76%; }
    </style>
  </head>
  <body>
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="7" y="3.5" width="3" height="3" fill="#e6b450"/><path d="M8.5 9.5V18a3 3 0 0 1-3 3H3" fill="none" stroke="#e6b450" stroke-width="3"/><rect x="13" y="3.5" width="7" height="14.5" fill="#bfbdb6"/></svg>
  </body>
</html>
