---
/**
 * Icon tile, rasterised at 32 and 180 by the capture step. One source for both
 * sizes keeps the mark identical to the favicon and the title bar.
 *
 * Colours come from tokens.css, not from literals: this route was hardcoded to the
 * palette the site was ported from, so every capture after the theme changed came
 * out in the old colours while looking like it had been regenerated.
 */
import '../styles/tokens.css';
---

<!doctype html>
<html lang="en" data-skin="wave">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>icon</title>
    <style>
      html, body { margin: 0; width: 180px; height: 180px; background: var(--bg); }
      svg { display: block; width: 180px; height: 180px; }
    </style>
  </head>
  <body>
    <svg viewBox="0 0 32 32" aria-hidden="true">
      <rect width="32" height="32" rx="7" fill="var(--bg)" />
      <g transform="translate(4 4)">
        <rect x="7" y="3.5" width="3" height="3" fill="var(--accent)" />
        <path d="M8.5 9.5V18a3 3 0 0 1-3 3H3" fill="none" stroke="var(--accent)" stroke-width="3" stroke-linecap="square" />
        <rect x="13" y="3.5" width="7" height="14.5" fill="var(--text)" />
      </g>
    </svg>
  </body>
</html>
