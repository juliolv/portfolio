---
import Base from '../layouts/Base.astro';
import Bi from '../components/Bi.astro';
import Hero from '../components/Hero.astro';
import WorkSection from '../components/WorkSection.astro';
import DevlogSection from '../components/DevlogSection.astro';
import ExperienceSection from '../components/ExperienceSection.astro';
import StackSection from '../components/StackSection.astro';
import { t, s, SITE, url } from '../lib/i18n';

const L = 'en' as const;
const aboutBody = t(L, 'about.body') as string[];
const aboutBodyEs = t('es', 'about.body') as string[];
---

<Base>
  <main class="view" id="view-home" tabindex="-1">
    <div class="wrap">
      <Hero />
      <WorkSection />
      <DevlogSection />
      <ExperienceSection />
      <StackSection />

      <section class="section" id="about" aria-labelledby="about-h">
        <div class="section__head">
          <p class="eyebrow">~/julio/<b>about</b></p>
          <h2 class="section__title" id="about-h"><Bi en={s(L, 'about.title')} es={s('es', 'about.title')} /></h2>
        </div>
        <div class="section__body">
          <div class="prose reveal">
            {aboutBody.map((paragraph, i) => (
              <p><Bi en={paragraph} es={aboutBodyEs[i]} /></p>
            ))}
          </div>
        </div>
      </section>

      <section class="section" id="contact" aria-labelledby="contact-h">
        <div class="section__head">
          <p class="eyebrow">~/julio/<b>contact</b></p>
          <h2 class="section__title" id="contact-h"><Bi en={s(L, 'contact.title')} es={s('es', 'contact.title')} /></h2>
        </div>
        <div class="section__body">
          <p class="lede reveal"><Bi en={s(L, 'contact.lede')} es={s('es', 'contact.lede')} /></p>

          <div class="contact__email reveal">
            <span class="contact__addr" id="email-text">{SITE.email}</span>
            <button class="btn" type="button" data-copy-email>
              <Bi en={s(L, 'contact.copy')} es={s('es', 'contact.copy')} />
            </button>
            <a class="btn btn--ghost" href={`mailto:${SITE.email}`}>
              <Bi en={s(L, 'contact.open')} es={s('es', 'contact.open')} />
            </a>
          </div>

          <div class="contact__links reveal">
            <a class="link link--mono" href={SITE.links.github} target="_blank" rel="noopener">github.com/juliolv ↗</a>
            <a class="link link--mono" href={SITE.links.linkedin} target="_blank" rel="noopener">linkedin.com/in/your-handle ↗</a>
            <a class="link link--mono" href={url(SITE.links.cv)} target="_blank" rel="noopener">
              <Bi en={s(L, 'hero.cv')} es={s('es', 'hero.cv')} /> ↓
            </a>
          </div>

          <p class="colophon">
            <Bi en={s(L, 'contact.colophon')} es={s('es', 'contact.colophon')} />
            {' '}<a class="link" href={url('/design-system/')}><Bi en={s(L, 'contact.colophonLink')} es={s('es', 'contact.colophonLink')} /></a>
          </p>
        </div>
      </section>
    </div>
  </main>
</Base>
