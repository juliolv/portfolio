---
/**
 * OG card, 1200x630. Rendered to PNG by the capture step and saved as
 * public/og.png; kept as a route so the image can be regenerated from code
 * instead of being a stale export nobody can edit.
 */
import '../styles/tokens.css';
import { s, SITE } from '../lib/i18n';

const L = 'en' as const;
---

<!doctype html>
<html lang="en" data-skin="custom">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>og</title>
    <style>
      html, body { margin: 0; width: 1200px; height: 630px; }
      body {
        background: var(--bg);
        color: var(--text);
        font-family: var(--font);
        display: grid;
        grid-template-rows: auto 1fr auto;
        padding: 72px 80px;
        box-sizing: border-box;
      }
      .top { display: flex; align-items: center; justify-content: space-between; }
      .brand { display: flex; align-items: center; gap: 16px; font-size: 26px; }
      .brand svg { width: 40px; height: 40px; }
      .tag {
        font-size: 18px; color: var(--muted);
        border: 1px solid var(--border-strong); border-radius: 4px; padding: 8px 14px;
      }
      h1 { margin: 0; font-size: 84px; line-height: 1.05; letter-spacing: -0.02em; }
      .role { margin: 18px 0 0; font-size: 34px; color: var(--accent); }
      .role b { font-weight: 400; color: var(--muted); }
      .foot { display: flex; align-items: center; justify-content: space-between; font-size: 20px; color: var(--muted); }
      .bar { display: flex; gap: 10px; }
      .bar i { width: 64px; height: 8px; display: block; }
      .bar i:nth-child(1) { background: var(--accent); }
      .bar i:nth-child(2) { background: var(--ok); }
      .bar i:nth-child(3) { background: var(--warn); }
    </style>
  </head>
  <body>
    <div class="top">
      <div class="brand">
        <svg class="logo" viewBox="0 0 24 24" aria-hidden="true"><rect x="7" y="3.5" width="3" height="3" fill="var(--accent)"/><path d="M8.5 9.5V18a3 3 0 0 1-3 3H3" fill="none" stroke="var(--accent)" stroke-width="3"/><rect x="13" y="3.5" width="7" height="14.5" fill="var(--text)"/></svg>
        {SITE.brand}<span style="color:var(--muted)">/portfolio</span>
      </div>
      <span class="tag"><span style="color:var(--ok)">●</span> {s(L, 'og.tag')}</span>
    </div>

    <div style="align-self:center">
      <h1>{SITE.name}</h1>
      <p class="role">❯ {s(L, 'hero.role')} <b>· {s(L, 'og.years')}</b></p>
    </div>

    <div class="foot">
      <span>juliolv.github.io/portfolio</span>
      <span class="bar" aria-hidden="true"><i></i><i></i><i></i></span>
    </div>
  </body>
</html>
