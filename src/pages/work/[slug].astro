---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Bi from '../../components/Bi.astro';
import { s, url } from '../../lib/i18n';

/** One page per markdown file in src/content/work; the filename is the slug. */
export async function getStaticPaths() {
  const items = await getCollection('work');
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

interface Props {
  item: CollectionEntry<'work'>;
}

const { item } = Astro.props as Props;
const { data } = item;

const STATUS_CLASS: Record<string, string> = {
  done: 'status--done',
  progress: 'status--progress',
  planned: 'status--planned',
};

/* Meta description from the problem statement, trimmed to a search-result length. */
const description =
  data.problem.length <= 155 ? data.problem : `${data.problem.slice(0, 154).trimEnd()}…`;
---

<Base
  title={`${data.name} — Julio López`}
  description={description}
  path={`~/julio/work/${item.id}`}
  active="work"
>
  <main class="view" id="top" tabindex="-1" data-view="case">
    <div class="wrap">
      <article class="section case" aria-labelledby="case-h">
        <div class="section__head">
          <p class="eyebrow">~/julio/work/<b>{item.id}</b>.md</p>
          <h1 class="section__title case__title" id="case-h">
            <Bi en={data.name} es={data.nameEs} />
          </h1>
          <p class="section__note">
            <Bi en={s('en', 'case.caseStudy')} es={s('es', 'case.caseStudy')} />
          </p>
        </div>

        <div class="section__body">
          <div class="case__block">
            <h2 class="eyebrow"><Bi en={s('en', 'case.overview')} es={s('es', 'case.overview')} /></h2>
            <dl class="kv">
              <dt><Bi en={s('en', 'case.period')} es={s('es', 'case.period')} /></dt>
              <dd><Bi en={data.period} es={data.periodEs} /></dd>

              <dt><Bi en={s('en', 'case.status')} es={s('es', 'case.status')} /></dt>
              <dd>
                <span class={`status ${STATUS_CLASS[data.status] ?? 'status--planned'}`}>
                  <span aria-hidden="true">●</span>
                  <Bi en={s('en', `status.${data.status}`)} es={s('es', `status.${data.status}`)} />
                </span>
              </dd>

              <dt><Bi en={s('en', 'case.stack')} es={s('es', 'case.stack')} /></dt>
              <dd>
                <span class="tags">
                  {data.stack.map((tech) => <span class="tag">{tech}</span>)}
                </span>
              </dd>
            </dl>
          </div>

          <div class="case__block">
            <h2 class="eyebrow"><Bi en={s('en', 'case.problem')} es={s('es', 'case.problem')} /></h2>
            <div class="prose">
              <p><Bi en={data.problem} es={data.problemEs} /></p>
            </div>
          </div>

          <div class="case__block">
            <h2 class="eyebrow"><Bi en={s('en', 'case.role')} es={s('es', 'case.role')} /></h2>
            <div class="prose">
              <p><Bi en={data.role} es={data.roleEs} /></p>
            </div>
          </div>

          <div class="case__block">
            <h2 class="eyebrow"><Bi en={s('en', 'case.outcome')} es={s('es', 'case.outcome')} /></h2>
            <div class="prose">
              <p><Bi en={data.outcome} es={data.outcomeEs} /></p>
            </div>
          </div>

          <p class="case__foot">
            <a class="link link--mono" href={url('/#work')}>
              <span aria-hidden="true">←</span>{' '}
              <Bi en={s('en', 'case.backToWork')} es={s('es', 'case.backToWork')} />
            </a>
          </p>
        </div>
      </article>
    </div>
  </main>
</Base>
