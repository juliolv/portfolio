---
import { readFileSync } from 'node:fs';
import '../styles/design-system.css';
import Base from '../layouts/Base.astro';
import Bi from '../components/Bi.astro';
import { s, url } from '../lib/i18n';

const L = 'en' as const;

/* The page reads the real stylesheet at build time, so the spec cannot drift
   from the values the site actually renders. */
const css = readFileSync(`${process.cwd()}/src/styles/design.css`, 'utf8');

function block(re: RegExp): Record<string, string> {
  const m = css.match(re);
  if (!m) return {};
  const out: Record<string, string> = {};
  for (const v of m[1].matchAll(/(--[a-z0-9-]+)\s*:\s*([^;}]+)/g)) {
    out[v[1]] = v[2].trim();
  }
  return out;
}

const light = block(/:root\s*\{([\s\S]*?)\n\}/);
const dark = block(/:root\[data-theme="dark"\]\s*\{([\s\S]*?)\n\}/);

const COLOR_TOKENS = [
  'bg', 'surface', 'surface-raised', 'border', 'border-strong', 'text', 'text-muted',
  'accent', 'accent-fg', 'accent-subtle', 'success', 'warning', 'danger', 'selection',
];

const pick = (prefixes: string[]) =>
  Object.keys(light).filter((key) => prefixes.some((p) => key === p || key.startsWith(p)));

const typeSize = pick(['--fs-']);
const typeLine = pick(['--lh-', '--ls-']);
const spaceScale = pick(['--sp-']);
const shapeScale = pick(['--r-', '--bw']);
const motionScale = pick(['--dur-', '--ease-']);
const layers = pick(['--z-']);

/** One demo row per duration token; the dot borrows that token's own timing. */
const motionDemos = motionScale
  .filter((token) => token.startsWith('--dur-'))
  .map((token) => ({
    token,
    value: light[token],
    duration: `var(${token})`,
    easing: 'var(--ease-out)',
    ease: 'ease-out',
  }));

const colors = COLOR_TOKENS.filter((t) => light[`--${t}`]);
---

<Base
  title="Design system — Julio López"
  description="The tokens and components this site is built from."
  path="~/julio/design-system"
  active="design-system"
>
  <main class="view" id="view-system">
    <div class="wrap ds">
      <header class="ds-head">
        <p class="prompt">
          <a class="link link--mono" href={url('/')}>~/julio</a><span>/</span><span class="prompt__cmd">design-system</span>
        </p>
        <h1 class="ds-title"><Bi en={s(L, 'ds.title')} es={s('es', 'ds.title')} /></h1>
        <p class="lede muted"><Bi en={s(L, 'ds.lede')} es={s('es', 'ds.lede')} /></p>
      </header>

      <div class="tabs" role="tablist" aria-label={s(L, 'ds.title')}>
        <button class="tab" type="button" role="tab" id="tab-tokens" aria-controls="panel-tokens" aria-selected="true" tabindex="0">{s(L, 'ds.tabTokens')}</button>
        <button class="tab" type="button" role="tab" id="tab-components" aria-controls="panel-components" aria-selected="false" tabindex="-1">{s(L, 'ds.tabComponents')}</button>
      </div>

      <div class="tabpanel" id="panel-tokens" role="tabpanel" aria-labelledby="tab-tokens">

      <section class="ds-section" aria-labelledby="ds-color">
        <h2 class="ds-section__title" id="ds-color">{s(L, 'ds.color')}</h2>
        <p class="ds-section__note"><Bi en={s(L, 'ds.colorNote')} es={s('es', 'ds.colorNote')} /></p>
        <div class="ds-grid">
          {colors.map((token) => (
            <div class="swatch">
              <div class="swatch__chip" style={`background: var(--${token})`}></div>
              <div class="swatch__meta">
                <span class="swatch__name">--{token}</span>
                <span class="swatch__hex" data-hex={token}>{light[`--${token}`]}</span>
                {dark[`--${token}`] && <span class="swatch__hex" data-hex-dark={token}>dark: {dark[`--${token}`]}</span>}
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="ds-section" aria-labelledby="ds-type">
        <h2 class="ds-section__title" id="ds-type">{s(L, 'ds.type')}</h2>
        <div class="ds-type-row">
          <span>--fs-7</span>
          <span style="font-size: var(--fs-7); line-height: var(--lh-tight); letter-spacing: var(--ls-tight); font-weight: 650;">
            <Bi en={s(L, 'ds.sample')} es={s('es', 'ds.sample')} />
          </span>
        </div>
        {typeSize.slice(1).map((token) => (
          <div class="ds-type-row">
            <span>{token}</span>
            <span style={`font-size: var(${token})`}>
              <Bi en={s(L, 'ds.sample')} es={s('es', 'ds.sample')} />
              <span class="swatch__hex" style="margin-left: var(--sp-3); font-family: var(--font-mono); font-size: var(--fs-2);">{light[token]}</span>
            </span>
          </div>
        ))}
        {typeLine.map((token) => (
          <div class="ds-row">
            <span class="ds-row__name">{token}</span>
            <span>{light[token]}</span>
            <span class="swatch__hex">line / tracking</span>
          </div>
        ))}
      </section>

      <section class="ds-section" aria-labelledby="ds-space">
        <h2 class="ds-section__title" id="ds-space">{s(L, 'ds.space')}</h2>
        <div class="ds-rows">
          {spaceScale.map((token) => (
            <div class="ds-row">
              <span class="ds-row__name">{token}</span>
              <span class="swatch__hex">{light[token]}</span>
              <span style={`width: var(${token}); height: 10px; background: var(--accent-subtle); border: var(--bw) solid var(--accent); justify-self: start;`}></span>
            </div>
          ))}
        </div>
      </section>

      <section class="ds-section" aria-labelledby="ds-shape">
        <h2 class="ds-section__title" id="ds-shape">{s(L, 'ds.shape')}</h2>
        <div class="ds-rows">
          {shapeScale.map((token) => (
            <div class="ds-row">
              <span class="ds-row__name">{token}</span>
              <span class="swatch__hex">{light[token]}</span>
              <span style={`width: 56px; height: 32px; background: var(--surface-raised); border: var(--bw-2) solid var(--border-strong); border-radius: var(${token});`}></span>
            </div>
          ))}
        </div>
      </section>

      <section class="ds-section" aria-labelledby="ds-motion">
        <h2 class="ds-section__title" id="ds-motion">{s(L, 'ds.motion')}</h2>
        <p class="ds-section__note"><Bi en={s(L, 'ds.motionNote')} es={s('es', 'ds.motionNote')} /></p>
        <div class="ds-rows">
          {motionDemos.map((demo) => (
            <button class="motion-row ds-row" type="button" aria-pressed="false">
              <span class="ds-row__name">{demo.token}</span>
              <span class="swatch__hex">{demo.value} · {demo.ease}</span>
              <span class="track"><i style={`transition-duration: ${demo.duration}; transition-timing-function: ${demo.easing};`}></i></span>
            </button>
          ))}
        </div>
      </section>

      <section class="ds-section" aria-labelledby="ds-layers">
        <h2 class="ds-section__title" id="ds-layers">{s(L, 'ds.layers')}</h2>
        <div class="ds-rows">
          {layers.map((token) => (
            <div class="ds-row">
              <span class="ds-row__name">{token}</span>
              <span class="swatch__hex">{light[token]}</span>
              <span></span>
            </div>
          ))}
        </div>
      </section>

      </div>

      <div class="tabpanel" id="panel-components" role="tabpanel" aria-labelledby="tab-components" hidden>
      <section class="ds-section" aria-labelledby="ds-components">
        <h2 class="ds-section__title" id="ds-components">components</h2>

        <div class="ds-samples">
          <button class="btn btn--primary" type="button">{s(L, 'ds.sPrimary')}</button>
          <button class="btn" type="button">{s(L, 'ds.sDefault')}</button>
          <button class="btn" type="button" disabled>{s(L, 'ds.sDisabled')}</button>
          <a class="link" href="#ds-components">{s(L, 'ds.sLink')}</a>
        </div>

        <div class="ds-samples">
          <span class="tag">tag</span>
          <span class="tag tag--accent">accent</span>
          <span class="tag tag--dashed"><Bi en={s(L, 'work.soon')} es={s('es', 'work.soon')} /></span>
          <span class="status status--done"><span aria-hidden="true">●</span> {s(L, 'status.done')}</span>
          <span class="status status--progress"><span aria-hidden="true">●</span> {s(L, 'status.progress')}</span>
          <span class="status status--planned"><span aria-hidden="true">●</span> {s(L, 'status.planned')}</span>
        </div>

        <p class="prompt" style="margin: var(--sp-4) 0;">
          <span class="prompt__glyph">›</span><span class="prompt__cmd">npm run build</span>
        </p>

        <div class="ds-panes">
          <section class="pane">
            <div class="pane__bar"><span class="pane__title">~/<b>pane</b></span><span>window</span></div>
            <div class="pane__body">
              <dl class="kv">
                <dt>tokens</dt><dd>single source</dd>
                <dt>js</dt><dd>5 KB, no framework</dd>
                <dt>output</dt><dd>static HTML</dd>
              </dl>
            </div>
          </section>

          <section class="pane">
            <div class="pane__bar"><span class="pane__title">~/<b>motion.css</b></span><span>css</span></div>
            <div class="pane__body">
              <pre class="code"><code><span class="c">/* Every component reads tokens, never literals. */</span>
.btn--primary &#123;
  <span class="k">background</span>: var(--accent);
  <span class="k">color</span>: var(--accent-fg);
  <span class="k">transition</span>: border-color var(--dur-fast);
&#125;</code></pre>
            </div>
          </section>
        </div>

        <ol class="tl" style="margin-top: var(--sp-4);">
          <li class="tl__item">
            <span class="tl__when">20XX — 20XX</span>
            <div>
              <h4 class="tl__role" style="margin:0;font-weight:600">{s(L, 'ds.sRole')}</h4>
              <p class="tl__org">{s(L, 'ds.sOrg')}</p>
            </div>
          </li>
        </ol>

        <p class="section__note" style="margin-top: var(--sp-4);">{s(L, 'ds.sElsewhere')}</p>
      </section>
      </div>
    </div>
  </main>
</Base>

<script>
  import '../scripts/design-system';
</script>
