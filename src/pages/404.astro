---
/**
 * 404, in the v2 language: a prompt that failed to run a file, and the three
 * places worth going instead. Standalone on purpose — a missing page should not
 * pull in the transcript, the dock or the dialogs.
 */
import '../styles/tokens.css';
import '../styles/base-v2.css';
import '../styles/components.css';
import Bi from '../components/Bi.astro';
import { s, url, SITE } from '../lib/i18n';

const L = 'en' as const;
---

<!doctype html>
<html lang="en" data-lang="en" data-skin="custom">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>404 · {SITE.name}</title>
    <meta name="description" content="That path does not exist." />
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#0c0f14" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fbf9f5" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="icon" type="image/png" sizes="32x32" href={url('/favicon-32.png')} />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const themes = ['custom','ayu','catppuccin','rose-pine','solarized','gruvbox'];
        let stored = null, lang = null;
        try { stored = localStorage.getItem('tui.skin'); lang = localStorage.getItem('tui.lang'); } catch {}
        const light = matchMedia('(prefers-color-scheme: light)').matches;
        root.dataset.skin = themes.includes(stored) ? stored : 'custom';
        if (lang !== 'en' && lang !== 'es') lang = (navigator.language || '').toLowerCase().startsWith('es') ? 'es' : 'en';
        root.dataset.lang = lang;
        root.lang = lang;
      })();
    </script>
    <style>
      .nf { display: flex; flex-direction: column; gap: var(--sp-5); padding-block: clamp(48px, 12vh, 120px); max-width: 62ch; }
      .nf__path { color: var(--muted); font-size: var(--fs-2); }
      .nf h1 { font-size: clamp(56px, 12vw, 96px); line-height: 1; letter-spacing: var(--ls-tight); }
      .nf__actions { display: flex; flex-wrap: wrap; gap: var(--sp-3); }
      .nf__brand { display: flex; align-items: center; gap: var(--sp-2); padding-block: var(--sp-3); text-decoration: none; font-size: var(--fs-3); }
      @media (max-width: 640px) { .nf__actions .btn { min-height: 44px; } }
    </style>
  </head>
  <body>
    <div class="app">
      <header>
        <a class="nf__brand" href={url('/')}>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><rect x="7" y="3.5" width="3" height="3" fill="var(--accent)"/><path d="M8.5 9.5V18a3 3 0 0 1-3 3H3" fill="none" stroke="var(--accent)" stroke-width="3"/><rect x="13" y="3.5" width="7" height="14.5" fill="var(--text)"/></svg>
          {SITE.brand}<span class="muted">/404</span>
        </a>
      </header>

      <main class="nf">
        <p class="turn__prompt" style="position:static">
          <span class="turn__glyph" aria-hidden="true">❯</span>
          <span>cat "$(wrong-path)"</span>
          <span class="turn__cmd">exit 1</span>
        </p>

        <h1>404</h1>

        <p class="nf__path">no such file or directory</p>

        <p class="hero__pitch">
          <Bi
            en="That path does not exist. The pages below do."
            es="Esa ruta no existe. Estas páginas sí."
          />
        </p>

        <div class="nf__actions">
          <a class="btn btn--primary" href={url('/')}>
            <span aria-hidden="true">←</span>
            <Bi en="Back to the start" es="Volver al inicio" />
          </a>
          <a class="btn" href={url('/#work')}><Bi en={s(L, 'nav.work')} es={s('es', 'nav.work')} /></a>
          <a class="btn" href={url('/#design-system')}><Bi en={s(L, 'nav.system')} es={s('es', 'nav.system')} /></a>
        </div>
      </main>
    </div>
  </body>
</html>
